# ENCORE LOCAL CONFIGURATION
# Run `pnpm setup:local` from the repository root. It creates apps/web/.env.local
# with a random session secret and never overwrites an existing file.
# Put real values ONLY in apps/web/.env.local; keep this example blank.
# NEXT_PUBLIC_* values are exposed to browsers. Other values stay server-side.
# Detailed instructions: docs/setup/CREDENTIALS.md

# 1. APPLICATION — local defaults; the URL must match your browser's origin.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Use the exact HTTPS browser origin in hosted environments. Defaults to NEXT_PUBLIC_APP_URL.
ENCORE_AUTH_ORIGIN=
# Exact comma-separated native callbacks. The current Expo app registers this callback.
ENCORE_NATIVE_REDIRECT_URIS=encore://auth/callback
# Generated by pnpm setup:local. At least 32 random bytes; not an API key.
ENCORE_SESSION_SECRET=
# memory = explicit local-only storage; supabase = real persistent database.
# Leave memory until Supabase credentials AND migrations have been verified.
ENCORE_IDENTITY_STORE=memory

# 2. POLLAR — required for social/email login and embedded wallets.
# Dashboard: https://dashboard.pollar.xyz/ -> Encore app -> API Keys.
# Copy the publishable key for your TEST environment, never a secret key here.
NEXT_PUBLIC_POLLAR_PUBLISHABLE_KEY=
# Enable after verifying email/social callbacks and embedded wallet provisioning.
NEXT_PUBLIC_POLLAR_SOCIAL_ENABLED=0

# 3. SUPABASE — project URL + backend secret key required for persistent storage.
# Dashboard: https://supabase.com/dashboard -> project -> Settings -> API Keys.
NEXT_PUBLIC_SUPABASE_URL=
# Modern publishable key (sb_publishable_...); currently optional for this app.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Modern backend secret (sb_secret_...); never prefix this with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Legacy alternatives: fill these only if using the older anon/service_role pair.
# A modern key and its legacy alternative do not both need to be populated.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 4. ELEVENLABS — conversational agent; music generation is outside this spike.
# Dashboard -> Developers -> API Keys; create an Agents-scoped key.
ELEVENLABS_API_KEY=
# Create "Encore Discovery Assistant" in ElevenAgents; copy its agent ID.
ELEVENLABS_AGENT_ID=

# 5. FIRECRAWL — one authorized public commissioning-brief extraction.
# Dashboard: https://www.firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=

# 6. SOLANA DEVNET — public configuration, no private keys or seed phrases.
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
# Leave blank until generated/verified during the devnet setup and deployment.
NEXT_PUBLIC_ENCORE_PROGRAM_ID=
NEXT_PUBLIC_TEST_USDC_MINT=

# 7. RESERVED FOR LATER CHECKPOINTS — not needed to create your accounts.
# Pollar secret is not used by the current session exchange; leave blank.
POLLAR_API_KEY=
# Generate separately when deploying the queue consumer; leave blank for now.
JOB_RUNNER_SECRET=
# Public reviewer wallet address; never a reviewer private key.
REVIEWER_AUTHORITY_PUBKEY=
