{
  "name": "encore",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": "^22.21.1 || ^24.0.0",
    "pnpm": "9.15.0"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@encore/web",
    "build": "turbo run build",
    "lint": "node --import tsx scripts/check-boundaries.ts",
    "typecheck": "turbo run typecheck && tsc -p tsconfig.tools.json",
    "test": "vitest run",
    "test:contracts": "anchor test",
    "test:e2e": "node --import tsx scripts/run-playwright.ts",
    "db:reset": "supabase db reset",
    "demo:seed": "node --import tsx scripts/not-ready.ts demo:seed",
    "demo:reset": "node --import tsx scripts/not-ready.ts demo:reset",
    "chain:build": "anchor build",
    "chain:deploy:devnet": "anchor deploy --provider.cluster devnet",
    "chain:generate": "node --import tsx scripts/not-ready.ts chain:generate",
    "reconcile": "node --import tsx scripts/reconcile-payments.ts",
    "check:setup": "node --import tsx scripts/bootstrap.ts",
    "setup:local": "node --import tsx scripts/bootstrap.ts --init",
    "spike:services": "node --import tsx scripts/spike-services.ts",
    "spike:pollar": "node --import tsx scripts/spike-pollar.ts",
    "spike:solana": "node --import tsx scripts/spike-solana.ts",
    "test:rust": "cargo test --locked --manifest-path programs/encore/Cargo.toml",
    "check:secrets": "node --import tsx scripts/check-secrets.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@pollar/core": "0.12.0",
    "@solana/spl-token": "0.4.14",
    "@solana/web3.js": "1.95.8",
    "@types/node": "22.20.7",
    "tsx": "4.23.15",
    "turbo": "2.11.13",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  },
  "type": "module"
}
