{
  "name": "encore",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@encore/web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:contracts": "anchor test",
    "test:e2e": "playwright test",
    "db:reset": "supabase db reset",
    "demo:seed": "tsx scripts/seed-demo.ts",
    "demo:reset": "tsx scripts/reset-demo.ts",
    "chain:build": "anchor build",
    "chain:deploy:devnet": "anchor deploy --provider.cluster devnet",
    "chain:generate": "tsx scripts/generate-types.ts",
    "reconcile": "tsx scripts/reconcile-payments.ts"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8"
  }
}
